<Project>
  <!--
    Altium.Designer.HotReload: Debug-only hot reload for Altium Designer extension shims.

    Debug builds:
      * compile the host sources (..\src\*.cs) into the shim as internal types;
      * the ProjectReference marked HotModule="true" is built but NOT referenced or copied;
      * its output path is baked into the generated constant HotReloadBuild.ModulePath.
    Other configurations: nothing is added. The HotModule reference is a normal ProjectReference,
    so the shim calls HotEntry directly.
  -->
  <PropertyGroup>
    <_AltiumHotReload Condition="'$(Configuration)' == 'Debug'">true</_AltiumHotReload>
  </PropertyGroup>

  <ItemGroup Condition="'$(_AltiumHotReload)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)..\src\*.cs" Link="HotReload\%(Filename)%(Extension)" Visible="false" />
    <!-- At evaluation time, so restore also sees it: the hot module is not a dependency of the Debug shim
         (it must not appear in the shim's .deps.json, since it is not deployed next to it). -->
    <ProjectReference Update="@(ProjectReference->WithMetadataValue('HotModule', 'true'))"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <Target Name="AltiumHotReloadModule" Condition="'$(_AltiumHotReload)' == 'true'" BeforeTargets="AssignProjectConfiguration;CoreCompile">
    <PropertyGroup>
      <_AltiumHotReloadBuildFile>$(IntermediateOutputPath)HotReloadBuild.g.cs</_AltiumHotReloadBuildFile>
    </PropertyGroup>
    <ItemGroup>
      <_AltiumHotModule Include="@(ProjectReference)" Condition="'%(ProjectReference.HotModule)' == 'true'" />
      <ProjectReference Condition="'%(ProjectReference.HotModule)' == 'true'">
        <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
        <Private>false</Private>
      </ProjectReference>
    </ItemGroup>
    <Error Condition="'@(_AltiumHotModule->Count())' != '1'"
           Text="Altium.Designer.HotReload: mark exactly one ProjectReference with HotModule=&quot;true&quot; (the implementation project)." />

    <MSBuild Projects="@(_AltiumHotModule)" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" PropertyName="_AltiumHotModulePath" />
    </MSBuild>

    <WriteLinesToFile File="$(_AltiumHotReloadBuildFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="// Generated by Altium.Designer.HotReload.targets;namespace Altium.Designer.HotReload { internal static class HotReloadBuild { public const string ModulePath = @&quot;$(_AltiumHotModulePath)&quot;%3B } }" />
    <ItemGroup>
      <Compile Remove="$(_AltiumHotReloadBuildFile)" />
      <Compile Include="$(_AltiumHotReloadBuildFile)" Visible="false" />
      <FileWrites Include="$(_AltiumHotReloadBuildFile)" />
    </ItemGroup>
  </Target>
</Project>
