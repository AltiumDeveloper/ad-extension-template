<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The shim: the only assembly Altium Designer loads directly. Keep it small and stable;
    changing it (or Installation\*) needs a redeploy and an AD restart.

    Debug:   loads DesignChecks.Impl from its build output through the hot-reload host
             (file watcher + dev pipe). Edit, build, and the running AD swaps it in.
    Release: references DesignChecks.Impl and calls HotEntry directly. No hot-reload code at all.
  -->
  <PropertyGroup>
    <RootNamespace>DesignChecks</RootNamespace>
    <UseAltiumSdk>true</UseAltiumSdk>
    <!-- Folder AD loads the extension from (tools\deploy.ps1): <Extensions folder>\DesignChecks. The Extensions folder is
         AltiumExtensionsDir if set, else that of the installation AltiumSystemDir belongs to (found by deploy.ps1). -->
    <ExtensionFolderName>DesignChecks</ExtensionFolderName>
    <!-- Identifies the extension in Extensions\ExtensionsRegistry.xml (tools\deploy.ps1). Generated once; keep it. -->
    <ExtensionGuid>d38a82fd-d801-4509-ac4a-1db514bc8a81</ExtensionGuid>
  </PropertyGroup>

  <ItemGroup>
    <!-- Debug-only hot reload host, compiled into the shim as source. Release builds contain none of it. -->
    <PackageReference Include="Altium.Designer.HotReload" Version="1.0.1" PrivateAssets="all" />
    <!-- HotModule="true": hot-reloaded from its build output in Debug, a normal reference otherwise. -->
    <ProjectReference Include="..\DesignChecks.Impl\DesignChecks.Impl.csproj" HotModule="true" />
  </ItemGroup>

  <!--
    Copy Installation\*.ins/.rcs to the output. Lines between "#if DEBUG" and "#endif" are kept
    in Debug and dropped otherwise (that is how the Developer menu exists only in Debug builds).
    The marker lines themselves never reach AD, and AD always gets Windows (CRLF) line endings,
    whatever the line endings of the source files.
  -->
  <ItemGroup>
    <InstallationFile Include="Installation\*.ins;Installation\*.rcs;Installation\*.out" />
    <UpToDateCheckInput Include="@(InstallationFile)" />
  </ItemGroup>

  <Target Name="CopyInstallationFiles" AfterTargets="Build"
          Inputs="@(InstallationFile);$(MSBuildProjectFullPath)"
          Outputs="@(InstallationFile->'$(OutDir)%(Filename)%(Extension)')">
    <PropertyGroup>
      <!-- Marker lines may be indented and the last line of a file (no line break after it). -->
      <_DebugBlock Condition="'$(Configuration)' == 'Debug'">(?m)^[ \t]*#(if DEBUG|endif)[ \t]*(\r?\n|\z)</_DebugBlock>
      <_DebugBlock Condition="'$(Configuration)' != 'Debug'">(?ms)^[ \t]*#if DEBUG[ \t]*\r?\n.*?^[ \t]*#endif[ \t]*(\r?\n|\z)</_DebugBlock>
    </PropertyGroup>
    <!-- Per file (batched on the item): drop or keep the Debug blocks, then make every line end CRLF. -->
    <WriteLinesToFile File="$(OutDir)%(InstallationFile.Filename)%(InstallationFile.Extension)"
                      Lines="$([System.Text.RegularExpressions.Regex]::Replace($([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('%(InstallationFile.FullPath)')), '$(_DebugBlock)', '')), '\r?\n', '&#13;&#10;'))"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <!-- An unmatched "#if DEBUG" or "#endif" would reach AD (and, in Release, the Debug-only lines with it). -->
    <Error Condition="$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('$(OutDir)%(InstallationFile.Filename)%(InstallationFile.Extension)')), '(?m)^[ \t]*#(if|else|endif)\b'))"
           File="%(InstallationFile.FullPath)"
           Text="Unmatched #if DEBUG / #endif in %(InstallationFile.Filename)%(InstallationFile.Extension): every '#if DEBUG' line needs an '#endif' line." />
  </Target>
</Project>
