# Normalize line endings in the repository; check out with Windows line endings (Altium Designer and
# Windows PowerShell 5.1 expect CRLF in .ins/.rcs/.out and .ps1 files).
* text=auto eol=crlf

*.png binary
*.ico binary
*.bmp binary
*.dll binary
*.nupkg binary

# The template's own .ins/.rcs/.out/.sln stay LF: the template engine's conditionals (//#if, #if) misread
# CRLF files. The generated shim's build writes the installation files for AD with CRLF.
source/Altium.Designer.Extension.Templates/content/**/*.ins text eol=lf
source/Altium.Designer.Extension.Templates/content/**/*.rcs text eol=lf
source/Altium.Designer.Extension.Templates/content/**/*.out text eol=lf
source/Altium.Designer.Extension.Templates/content/**/*.sln text eol=lf
